; Expected: sat.
; Pattern 0111111 is a genuine strict assignment.  A wrong characterization
; that requires S1 and drops the Rq alternative rejects it.
(set-logic QF_LIA)
(declare-const S1 Bool)
(declare-const S2 Bool)
(declare-const Rq Bool)
(declare-const D Bool)
(declare-const T Bool)
(declare-const Eshare Bool)
(declare-const X Bool)
(assert (= S1 false))
(assert (= S2 true))
(assert (= Rq true))
(assert (= D true))
(assert (= T true))
(assert (= Eshare true))
(assert (= X true))
(define-fun actualStrict () Bool (and S2 D T Eshare X (or S1 Rq)))
(define-fun wrongPrediction () Bool (and S2 D T Eshare X S1))
(assert actualStrict)
(assert (not wrongPrediction))
(check-sat)
(get-model)
