(set-logic ALL)
(declare-sort State 0)
(declare-fun R (State State) Bool)
(declare-fun Unsafe (State) Bool)
(assert (forall ((s State) (t State))
  (=> (and (R s t) (Unsafe s)) (Unsafe t))))
(declare-const s State)
(declare-const t State)
(assert (R s t))
(assert (Unsafe s))
(assert (not (Unsafe t)))
(check-sat)
