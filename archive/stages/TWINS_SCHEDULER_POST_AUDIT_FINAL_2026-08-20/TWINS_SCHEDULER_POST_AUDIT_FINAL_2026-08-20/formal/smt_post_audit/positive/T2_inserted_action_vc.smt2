(set-logic ALL)
(declare-sort State 0)
(declare-fun R (State State) Bool)
(assert (forall ((x State) (y State) (z State))
  (=> (and (R x y) (R y z)) (R x z))))
(declare-const s State)
(declare-const t State)
(declare-const tNext State)
(assert (R s t))
(assert (R t tNext))
(assert (not (R s tNext)))
(check-sat)
