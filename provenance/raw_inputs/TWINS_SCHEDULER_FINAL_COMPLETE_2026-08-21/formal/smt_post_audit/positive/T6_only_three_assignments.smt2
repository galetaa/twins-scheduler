(set-logic QF_UF)
(declare-const S1 Bool)
(declare-const S2 Bool)
(declare-const Rq Bool)
(declare-const D Bool)
(declare-const T Bool)
(declare-const Ed Bool)
(declare-const X Bool)
(define-fun U ((e Bool) (r Bool)) Bool
  (and (or (not S1) e)
       (or (not S2)
           (and (or (not Rq) e)
                (not (and r D T))))))
(define-fun Strict () Bool
  (and X Ed (U true false) (not (U false false)) (not (U true true))))
(define-fun P0111111 () Bool (and (not S1) S2 Rq D T Ed X))
(define-fun P1101111 () Bool (and S1 S2 (not Rq) D T Ed X))
(define-fun P1111111 () Bool (and S1 S2 Rq D T Ed X))
(assert Strict)
(assert (not (or P0111111 P1101111 P1111111)))
(check-sat)
