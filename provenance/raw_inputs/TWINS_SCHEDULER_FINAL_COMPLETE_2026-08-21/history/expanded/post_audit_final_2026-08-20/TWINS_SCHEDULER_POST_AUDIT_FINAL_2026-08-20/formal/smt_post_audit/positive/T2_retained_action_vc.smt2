(set-logic ALL)
(declare-sort State 0)
(declare-sort Action 0)
(declare-fun R (State State) Bool)
(declare-fun step (State Action) State)
(assert (forall ((s State) (t State) (a Action))
  (=> (R s t) (R (step s a) (step t a)))))
(declare-const s State)
(declare-const t State)
(declare-const a Action)
(assert (R s t))
(assert (not (R (step s a) (step t a))))
(check-sat)
