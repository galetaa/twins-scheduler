(set-logic QF_LIA)
; When E and R are in different views, a view-indexed directed policy can deliver E and withhold R.
(declare-const f Int)
(assert (>= f 1))
(define-fun q () Int (+ (* 2 f) 1))
(define-fun base () Int (* 2 f))
(declare-const deliverE Bool)
(declare-const deliverR Bool)
(assert deliverE)
(assert (not deliverR))
(define-fun c0 () Bool (>= (+ base (ite deliverE 1 0)) q))
(define-fun c1 () Bool (>= (+ base (ite (and deliverE (not deliverR)) 1 0)) q))
(assert (and c0 c1))
(check-sat)
