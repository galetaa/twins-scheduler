(set-logic ALL)
(declare-sort State 0)
(declare-sort Event 0)
(declare-sort Projection 0)
(declare-fun pi (State) Projection)
(declare-fun delta (State Event) State)
(assert (forall ((s State) (t State) (m Event))
  (=> (= (pi s) (pi t))
      (= (pi (delta s m)) (pi (delta t m))))))
(declare-const s State)
(declare-const t State)
(declare-const m Event)
(assert (= (pi s) (pi t)))
(assert (not (= (pi (delta s m)) (pi (delta t m)))))
(check-sat)
